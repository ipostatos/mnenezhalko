generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Пользователь бота (Telegram)
model User {
  tgId        BigInt   @id
  username    String?
  firstName   String?
  lang        String   @default("ru")
  city        String?
  isAdmin     Boolean  @default(false)
  /// присылать ли анонсы новых встреч
  eventAlerts Boolean  @default(true)
  createdAt   DateTime @default(now())
  seenAt      DateTime @default(now())

  /// active | banned. «Ограничен» отдельным состоянием НЕ храним: это
  /// вычисляется по действующим UserRestriction, иначе появился бы второй
  /// источник правды, который рано или поздно разойдётся с первым
  accountStatus String    @default("active")
  bannedAt      DateTime?
  bannedByTg    BigInt?
  banReason     String?

  librarian    Librarian?
  restrictions UserRestriction[]
  marketItems  MarketItem[]
  events       Event[]
  loansGiven   Loan[]            @relation("LoansGiven")
  loansTaken   Loan[]            @relation("LoansTaken")
  reviews      Review[]
  waitings     Waiting[]
}

/// Библиотекарь — владелец книг. Приходит из Notion либо создаётся ботом.
model Librarian {
  id                  String    @id @default(cuid())
  notionId            String?   @unique
  name                String
  telegram            String? // @handle без ссылки
  /// нормализованный ник для матчинга: lower-case, без @/ссылки (см. normHandle)
  telegramNorm        String?
  instagram           String?
  city                String?
  district            String?
  tgId                BigInt?   @unique
  /// куда объединён дубль; непусто — запись архивная, книги перенесены на главную
  mergedIntoId        String?
  /// когда последний раз сверяли Telegram-контакт с этой записью
  lastTelegramSyncAt  DateTime?
  /// локальный telegram изменился, но ещё не отправлен в Notion (дожать flushTelegramUpdates)
  telegramSyncPending Boolean   @default(false)
  createdAt           DateTime  @default(now())

  user  User?  @relation(fields: [tgId], references: [tgId])
  books Book[]

  @@index([city])
  @@index([telegramNorm])
}

/// Книга или настольная игра в библиотеке проекта
model Book {
  id                   String    @id @default(cuid())
  notionId             String?   @unique
  kind                 String    @default("book") // book | game
  title                String
  author               String?
  genres               String    @default("") // через запятую
  languages            String    @default("") // через запятую
  city                 String?
  district             String?
  coverUrl             String?
  status               String    @default("free") // free | busy
  addedAt              DateTime?
  source               String    @default("notion") // notion | bot
  /// путь карточки в общую таблицу: local | pending | synced | failed
  notionStatus         String    @default("local")
  notionError          String?
  /// состояние модерации: pending | approving | approved | rejected | deleted.
  /// approving — переходное: один админ уже жмёт «одобрить» (см. approveBook).
  /// Дефолт approved — книги из Notion и режим без модерации попадают в каталог сразу.
  reviewStatus         String    @default("approved")
  reviewedByTg         BigInt?
  reviewedAt           DateTime?
  /// когда и кто начал одобрение — для восстановления зависшего approving
  approvalStartedAt    DateTime?
  approvalStartedByTg  BigInt?
  approvalAttempt      Int       @default(0)
  rejectionReason      String?
  submittedAt          DateTime?
  deletedAt            DateTime?
  deletedByTg          BigInt?
  /// книга на руках, владелец попросил скрыть её после возврата
  hideAfterReturn      Boolean   @default(false)
  /// строку в Notion не удалось заархивировать при удалении — дожать (flushPending)
  notionArchivePending Boolean   @default(false)
  addedByTg            BigInt?
  search               String    @default("") // нормализованная строка для поиска
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  ownerId  String?
  owner    Librarian? @relation(fields: [ownerId], references: [id])
  loans    Loan[]
  reviews  Review[]
  waitings Waiting[]

  @@index([kind])
  @@index([city])
  @@index([ownerId])
  @@index([reviewStatus])
}

/// Оценка и короткая аннотация от того, кто книгу прочитал.
///
/// Ключ — ПРОИЗВЕДЕНИЕ (`workKey` = нормализованные автор + название), а не
/// карточка: у одной книги в каталоге по экземпляру на каждого библиотекаря, и
/// при привязке к `Book.id` у трёх экземпляров получилось бы три независимых
/// рейтинга по одной оценке в каждом. `bookId` остаётся ссылкой на экземпляр,
/// с которого отзыв оставили (может исчезнуть — тогда null, отзыв живёт).
model Review {
  id      String  @id @default(cuid())
  workKey String
  bookId  String?
  book    Book?   @relation(fields: [bookId], references: [id], onDelete: SetNull)

  authorTg BigInt
  author   User   @relation(fields: [authorTg], references: [tgId], onDelete: Cascade)

  /// 1..5, проверяется в reviews.ts (SQLite не умеет CHECK через Prisma)
  rating Int
  /// короткая аннотация, до 300 знаков; null — поставили только оценку
  text   String?

  /// visible | hidden — скрыт модератором или автоматически по жалобам
  status     String    @default("visible")
  reports    Int       @default(0)
  hiddenAt   DateTime?
  hiddenByTg BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reportRows ReviewReport[]

  /// один отзыв на человека на произведение: повторная оценка обновляет свою,
  /// а не плодит вторую. Гарантия на уровне базы, а не только в коде.
  @@unique([workKey, authorTg])
  @@index([workKey, status])
  @@index([authorTg])
}

/// Жалоба на отзыв: строка на человека, а не счётчик.
///
/// Раньше жалоба просто увеличивала `Review.reports`, и один человек тремя
/// нажатиями прятал ЛЮБОЙ чужой отзыв (найдено внешним аудитом 30.07.2026 —
/// в комментарии было обещано «повторная жалоба того же человека не считается»,
/// а в базе этого не было ничем обеспечено). Уникальность здесь и есть та
/// гарантия: повторная жалоба падает на ограничении, а не удваивает счётчик.
model ReviewReport {
  id         String   @id @default(cuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterTg BigInt
  createdAt  DateTime @default(now())

  @@unique([reviewId, reporterTg])
  @@index([reviewId])
}

/// Агрегат оценок по произведению: средняя считается как sum/count.
///
/// Денормализация нужна каталогу: без неё страница из 40 книг превращалась бы
/// в 40 агрегирующих запросов, а сортировка по рейтингу — в скан всех отзывов.
/// Обновляется в одной транзакции с самим отзывом (см. recountWork).
model WorkRating {
  workKey   String   @id
  count     Int      @default(0)
  sum       Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// «У кого моя книга сейчас»: выдача книги из рук в руки
model Loan {
  id     String  @id @default(cuid())
  /// название как ввёл владелец — книги может не быть в библиотеке
  title  String
  /// карточка книги, если выдавали со своей полки
  bookId String?
  book   Book?   @relation(fields: [bookId], references: [id])

  /// Владелец. NULL бывает у ЗАКРЫТОЙ выдачи, чей владелец удалил свои данные:
  /// строка остаётся историей обмена, но человека в ней уже не опознать
  /// (см. server/src/mydata.ts). У активной выдачи владелец есть всегда.
  ownerTg BigInt?
  owner   User?   @relation("LoansGiven", fields: [ownerTg], references: [tgId])

  /// у кого книга: ник обязателен, id появляется, когда человек откроет бота
  holderUsername String?
  holderName     String?
  holderTg       BigInt?
  holder         User?   @relation("LoansTaken", fields: [holderTg], references: [tgId])

  /// Копия bookId, пока выдача активна; у закрытой выдачи NULL. Уникальность по
  /// этому полю и есть запрет «две активные выдачи одной книги» на уровне базы:
  /// SQLite не считает NULL совпадающими, поэтому закрытых выдач может быть
  /// сколько угодно, а выдач без книги (bookId NULL) — тоже. Проверки в коде
  /// (createLoan, reopenLoan) остаются, здесь страховка от гонок.
  activeBookId String?

  status     String    @default("active") // active | returned
  takenAt    DateTime  @default(now())
  dueAt      DateTime?
  returnedAt DateTime?
  /// когда последний раз напоминали — чтобы не долбить каждый день
  remindedAt DateTime?
  note       String?

  /// hash одноразового claim-токена ссылки-приглашения (сырой токен нигде не
  /// хранится, только показывается один раз в сообщении); null — выдача либо
  /// уже привязана, либо ждёт токена, либо это старая выдача до этой защиты
  claimTokenHash      String?   @unique
  claimTokenExpiresAt DateTime?

  events LoanEvent[]

  @@unique([activeBookId])
  @@index([ownerTg, status])
  @@index([holderTg, status])
}

/// Событие в жизни выдачи — честная история вместо реконструкции из состояния.
model LoanEvent {
  id     String   @id @default(cuid())
  loanId String
  loan   Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  /// created | claimed | reminded | returned | reopened | cancelled
  kind   String
  byTg   BigInt?
  at     DateTime @default(now())
  meta   String?

  @@index([loanId])
}

/// Очередь на занятую книгу: «сообщите, когда освободится» (issue #10).
///
/// В отличие от оценки, очередь висит на ЭКЗЕМПЛЯРЕ (`bookId`), а не на
/// произведении: ждут не текст, а конкретную книгу у конкретного человека в
/// конкретном городе, и уведомление рождается из возврата именно этого
/// экземпляра. Человеку, который ждёт «хоть какую-нибудь копию», карточка и так
/// подсказывает, где ещё она есть.
model Waiting {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  userTg BigInt
  user   User   @relation(fields: [userTg], references: [tgId], onDelete: Cascade)

  /// waiting — стоит в очереди;
  /// ready — книга освободилась, сообщение ещё не доставлено (добивает джоба);
  /// notified — сообщение ушло, очередь для этого человека закрыта;
  /// left — ушёл сам («больше не жду») либо запись протухла по сроку.
  ///
  /// Отдельный `ready` нужен ровно затем, чтобы обещание пережило падение и
  /// деплой: возврат книги фиксируется в базе одной транзакцией с постановкой
  /// в ready, а отправка сообщения — дело ненадёжное и внешнее.
  status String @default("waiting")

  createdAt  DateTime  @default(now())
  /// когда книгу освободили и человека выбрали следующим
  readyAt    DateTime?
  /// когда сообщение реально доставлено
  notifiedAt DateTime?
  /// мёртвая очередь не должна жить вечно: протухшие записи не уведомляются
  expiresAt  DateTime
  /// сколько раз не удалось доставить сообщение — чтобы не долбить вечно
  attempts   Int       @default(0)
  leftAt     DateTime?

  /// один человек стоит в очереди на книгу один раз: повторное нажатие «ждать»
  /// правит свою запись, а не плодит вторую. Гарантия на уровне базы.
  @@unique([bookId, userTg])
  @@index([status, readyAt])
  @@index([bookId, status, createdAt])
  @@index([userTg, status])
}

/// Городские чаты и каналы проекта
model CityGroup {
  id    Int    @id @default(autoincrement())
  city  String
  title String
  url   String
  kind  String @default("chat") // chat | channel | folder
  sort  Int    @default(0)

  @@index([city])
}

/// Ближайшие встречи по городам
model Event {
  id               String   @id @default(cuid())
  city             String
  title            String
  startsAt         DateTime
  place            String?
  description      String?
  url              String?
  /// откуда встреча: admin | topic (афиша из чата проекта)
  source           String   @default("admin")
  /// id сообщения-афиши + порядковый номер встречи в нём: одно сообщение может
  /// нести несколько встреч, дедуп только по msgId терял все, кроме первой
  sourceMsgId      Int?
  sourceEventIndex Int?
  createdAt        DateTime @default(now())
  createdBy        BigInt?
  /// снята админом: строку НЕ удаляем физически, иначе повторный импорт темы
  /// заведёт встречу заново (дедуп идёт по sourceMsgId), а в журнале модерации
  /// останется ссылка в никуда. Кто и когда снял — в ModerationAction
  removedAt        DateTime?

  author User? @relation(fields: [createdBy], references: [tgId])

  @@unique([sourceMsgId, sourceEventIndex])
  @@index([city, startsAt])
}

/// Барахолка по городам
model MarketItem {
  id          String    @id @default(cuid())
  /// город проекта: по нему работает фильтр. «Все города» — если справочник
  /// агломераций такого населённого пункта не знает (см. agglomeration.ts)
  city        String
  /// исходный населённый пункт, если это не сам город проекта: «Wieliczka»
  /// при городе «Kraków». Показывается подписью «Kraków (Wieliczka)»
  locality    String?
  kind        String    @default("give") // give | sell | search
  title       String
  description String?
  price       String?
  photo       String? // telegram file_id
  status      String    @default("active") // active | closed | removed (снято модератором)
  /// когда объявление протухает и закрывается автоматически (см. expireMarketItems);
  /// null у старых строк — для них срок считается от bumpedAt
  expiresAt   DateTime?
  /// откуда объявление: bot | topic (барахолка в чате проекта)
  source      String    @default("bot")
  /// id сообщения в теме барахолки — чтобы не заводить дважды
  sourceMsgId Int?      @unique
  createdAt   DateTime  @default(now())
  bumpedAt    DateTime  @default(now())

  authorTg       BigInt
  authorUsername String?
  author         User    @relation(fields: [authorTg], references: [tgId])

  @@index([city, status, bumpedAt])
}

/// Служебное key-value (курсоры синхронизации и т.п.)
model SyncState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Журнал исполненных удалений данных.
///
/// Нужен ровно для одного случая: восстановили старую резервную копию — в ней
/// снова лежат данные человека, который просил их удалить. Журнал позволяет
/// применить удаления повторно, не полагаясь на память администратора.
///
/// Самого Telegram id тут НЕТ: хранится только хэш (см. mydata.ts::tgHash).
/// По хэшу можно проверить «этого ли человека удаляли», но не узнать, кого.
model DeletionRequest {
  id          String    @id @default(cuid())
  /// sha256(секрет вебхука + tgId) — сверять можно, восстановить id нельзя
  tgHash      String    @unique
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  /// что именно унесли: сводка числами, без содержимого
  summary     String?
}

/// Точечное ограничение: запрет на ОДНО действие, а не на весь аккаунт.
///
/// Человеку можно закрыть отзывы за грубость, но оставить полку, возвраты и
/// очереди: блокировка целиком слишком груба и бьёт по тем, кто ждёт его книги.
/// Снятое ограничение не удаляется — история решений должна оставаться.
model UserRestriction {
  id     String @id @default(cuid())
  userTg BigInt
  user   User   @relation(fields: [userTg], references: [tgId], onDelete: Cascade)

  /// add_books | reviews | reports | waitlist | market | ai | all
  scope       String
  reason      String
  createdByTg BigInt
  createdAt   DateTime  @default(now())
  /// null — бессрочно; иначе перестаёт действовать само, без вмешательства
  expiresAt   DateTime?
  liftedAt    DateTime?
  liftedByTg  BigInt?

  @@index([userTg, scope, liftedAt])
}

/// Неизменяемый журнал решений модераторов.
///
/// Решение нельзя «просто перезаписать» в User: тогда нельзя ответить на
/// вопросы «кто это сделал», «почему» и «что было до». Строки отсюда не
/// правятся и не удаляются — новое решение это новая строка.
model ModerationAction {
  id           String   @id @default(cuid())
  actorTg      BigInt?
  targetUserTg BigInt?
  /// Отпечаток цели (HMAC, см. mydata.ts::tgHash). Появляется, когда человек
  /// удалил свои данные: сам факт решения в истории остаётся, а сырого
  /// Telegram id в журнале после обещания «удалим» быть не должно.
  targetHash   String?
  /// то же для автора решения, если свои данные удалил администратор
  actorHash    String?
  /// user | review | book | market | event | message
  targetType   String
  targetId     String?
  /// restrict | unrestrict | ban | unban | hide | restore | delete | dismiss |
  /// remove (объявление, встреча) | spam_delete | spam_false_positive
  action       String
  reason       String
  /// подробности решения в JSON — например, срок ограничения
  meta         String?
  createdAt    DateTime @default(now())

  @@index([targetUserTg, createdAt])
  @@index([targetType, targetId])
}

/// Исходящие сообщения людям: решение записано, письмо ещё не ушло.
///
/// Между «решение сохранено» и «сообщение отправлено» процесс может упасть, и
/// человек не узнает об ограничении. Поэтому письмо кладётся в ту же
/// транзакцию, что и решение, а отправкой занимается фоновая джоба — тот же
/// приём, что и с обещанием «сообщим, когда книга освободится» (waitlist.ts).
model NotificationOutbox {
  id          String    @id @default(cuid())
  recipientTg BigInt
  /// moderation | ... — на будущее, чтобы очередь годилась не только модерации
  kind        String
  payload     String
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([sentAt, createdAt])
}
