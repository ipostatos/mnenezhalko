{
  "name": "@mnenezhalko/server",
  "private": true,
  "version": "0.2.0-beta.2",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "sync": "tsx src/sync-cli.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "notion:check": "tsx src/notion-check.ts",
    "privacy:reapply": "tsx src/privacy-reapply.ts",
    "import": "tsx src/import-topic.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.2",
    "@prisma/client": "^6.2.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "grammy": "^1.33.0",
    "prisma": "^6.2.1",
    "sharp": "^0.35.3",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
