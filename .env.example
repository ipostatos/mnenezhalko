# Telegram
BOT_TOKEN=123456:AA...
# Публичный HTTPS-адрес, на котором раздаётся Mini App (без слэша в конце)
PUBLIC_URL=https://mnenezhalko.example.com
# Режим получения апдейтов: polling (локально) | webhook (прод)
BOT_MODE=polling

# Хранилище
DATABASE_URL=file:../data/mnenezhalko.db

# Сервер
PORT=8080
HOST=0.0.0.0

# Notion (публичная страница проекта, синк только на чтение)
NOTION_SPACE_ID=5918928c-3188-457e-a69e-961acdc128e3
NOTION_BOOKS_COLLECTION=53f0bd43-f6da-419b-9f38-f769d828c3c5
NOTION_BOOKS_VIEW=efab27f6-9f91-4b37-8b72-b20178b88f9c
NOTION_LIBRARIANS_COLLECTION=c75bfeab-27de-4b18-89ff-22f1775a7d22
NOTION_LIBRARIANS_VIEW=ee305902-186b-4678-bc21-66899f807a72
NOTION_GAMES_COLLECTION=1c144aab-976e-4488-b090-6079c9bc109f
NOTION_GAMES_VIEW=46806d71-df83-4412-9270-bde93c4692b8
# Автосинк раз в N часов (0 — выключить)
NOTION_SYNC_HOURS=12

# Запись в общие таблицы Notion (Owners, All Books, Board Games).
# Cookie token_v2 аккаунта, который открыл публичную ссылку проекта:
# notion.so → DevTools → Application → Cookies → token_v2.
# Без него книги копятся локально со статусом pending, админам летит уведомление.
NOTION_TOKEN_V2=
# Нужен, только если у аккаунта несколько пространств
NOTION_USER_ID=

# ИИ-помощник (без ключа бот работает, но подбор идёт по обычному поиску)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Админы бота через запятую (telegram user id)
ADMIN_IDS=

# Ссылка на общий чат проекта
MAIN_CHAT_URL=https://t.me/+hlRk_HGIDcE4M2Vi
