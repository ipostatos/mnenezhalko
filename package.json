{
  "name": "mnenezhalko",
  "private": true,
  "version": "0.1.0",
  "description": "Telegram-бот и Mini App книжного проекта «МнеНеЖалко» в Польше",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "sync": "npm run sync -w server"
  }
}
