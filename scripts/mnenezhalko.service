[Unit]
Description=MneNeZhalko book-exchange bot and Mini App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mnenezhalko/server
EnvironmentFile=/opt/mnenezhalko/server/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
