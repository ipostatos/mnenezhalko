[Unit]
Description=MneNeZhalko book-exchange bot and Mini App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Своя учётка: в .env лежат токен бота и cookie рабочего аккаунта Notion,
# процессу, открытому в интернет, права root ни к чему.
# Код раскладывает выкладка от root (сервису — только чтение), писать нужно лишь
# в shared/data: база, обложки и кэш превью.
#
# ⚠️ Путь идёт через симлинк current: он указывает на текущий релиз
# (/opt/mnenezhalko/releases/<sha>), и systemd разрешает его при КАЖДОМ старте.
# Поэтому «переключить релиз» = переставить симлинк и перезапустить службу,
# а не перезаписывать файлы под работающим процессом.
User=mnenezhalko
Group=mnenezhalko
WorkingDirectory=/opt/mnenezhalko/current/server
EnvironmentFile=/opt/mnenezhalko/shared/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Базовая изоляция
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/mnenezhalko/shared/data

[Install]
WantedBy=multi-user.target
